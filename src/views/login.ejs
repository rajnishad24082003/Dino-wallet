<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Dino Wallet Login</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 flex items-center justify-center h-screen text-white">
    <form action="/auth/login" method="POST" class="bg-gray-800 p-8 rounded shadow-lg w-96">
        <h2 class="text-2xl font-bold mb-6 text-green-400">Dino Wallet</h2>
        
        <% if (error) { %>
            <div class="bg-red-500 text-white p-2 rounded mb-4 text-sm"><%= error %></div>
        <% } %>

        <div class="mb-4">
            <label class="block text-sm mb-2">Email</label>
            <input name="email" type="email" class="w-full p-2 rounded bg-gray-700 focus:outline-none focus:ring-2 focus:ring-green-500" required>
        </div>
        <div class="mb-6">
            <label class="block text-sm mb-2">Password</label>
            <input name="password" type="password" class="w-full p-2 rounded bg-gray-700 focus:outline-none focus:ring-2 focus:ring-green-500" required>
        </div>
        <button type="submit" class="w-full bg-green-500 hover:bg-green-600 text-black font-bold py-2 rounded">Sign In</button>
    </form>
</body>
</html>