<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Admin Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-900 text-gray-100 min-h-screen p-8">
    <div class="max-w-6xl mx-auto">
        <div class="flex justify-between items-center mb-8">
            <h1 class="text-2xl font-bold text-red-500">SYSTEM ADMIN</h1>
            <a href="/auth/logout" class="text-gray-400 hover:text-white">Logout</a>
        </div>

        <div class="grid grid-cols-1 gap-8">
            <div class="bg-gray-800 rounded-lg p-6 border border-gray-700">
                <h2 class="text-xl font-bold mb-4 text-blue-400">User Accounts</h2>
                <div class="overflow-x-auto">
                    <table class="w-full text-sm text-left text-gray-400">
                        <thead class="text-xs text-gray-200 uppercase bg-gray-700">
                            <tr>
                                <th class="px-4 py-3">Username</th>
                                <th class="px-4 py-3">Email</th>
                                <th class="px-4 py-3">Role</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% users.forEach(u=> { %>
                                <tr class="border-b border-gray-700">
                                    <td class="px-4 py-3 font-medium text-white">
                                        <%= u.username %>
                                    </td>
                                    <td class="px-4 py-3">
                                        <%= u.email %>
                                    </td>
                                    <td class="px-4 py-3">
                                        <span class="<%= u.role === 'ADMIN' ? 'text-red-400' : 'text-green-400' %>">
                                            <%= u.role %>
                                        </span>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="bg-gray-800 rounded-lg p-6 border border-blue-500 mb-8">
                <h2 class="text-xl font-bold mb-4 text-blue-400">Grant Funds (Treasury -> User)</h2>
                <form id="grantForm" class="flex flex-wrap gap-4 items-end">

                    <div class="flex-1 min-w-[200px]">
                        <label class="block text-xs text-gray-400 mb-1">User Email</label>
                        <input type="email" id="targetEmail" placeholder="e.g. p1@dino.com"
                            class="w-full bg-gray-700 text-white p-2 rounded" required>
                    </div>

                    <div class="w-32">
                        <label class="block text-xs text-gray-400 mb-1">Asset</label>
                        <select id="grantAsset" class="w-full bg-gray-700 text-white p-2 rounded">
                            <option value="GOLD">GOLD</option>
                            <option value="DIAMOND">DIAMOND</option>
                        </select>
                    </div>

                    <div class="w-32">
                        <label class="block text-xs text-gray-400 mb-1">Amount</label>
                        <input type="number" id="grantAmount" placeholder="0.00"
                            class="w-full bg-gray-700 text-white p-2 rounded" required>
                    </div>

                    <button type="submit"
                        class="bg-blue-600 hover:bg-blue-500 text-white px-6 py-2 rounded font-bold h-[42px]">
                        SEND
                    </button>
                </form>
                <p id="adminMsg" class="mt-2 text-sm"></p>
            </div>

            <script>
                document.getElementById('grantForm').addEventListener('submit', async (e) => {
                    e.preventDefault();
                    const msg = document.getElementById('adminMsg');

                    try {
                        const res = await fetch('/api/transaction', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                type: 'DEPOSIT',
                                targetEmail: document.getElementById('targetEmail').value,
                                assetCode: document.getElementById('grantAsset').value,
                                amount: Number(document.getElementById('grantAmount').value),
                                idempotencyKey: crypto.randomUUID()
                            })
                        });

                        if (res.ok) {
                            window.location.reload();
                        } else {
                            const data = await res.json();
                            msg.innerText = "Error: " + data.error;
                            msg.className = "mt-2 text-sm text-red-500";
                        }
                    } catch (err) {
                        console.error(err);
                    }
                });
            </script>

            <div class="bg-gray-800 rounded-lg p-6 border border-gray-700">
                <h2 class="text-xl font-bold mb-4 text-yellow-400">Recent Transactions</h2>
                <div class="overflow-x-auto">
                    <table class="w-full text-sm text-left text-gray-400">
                        <thead class="text-xs text-gray-200 uppercase bg-gray-700">
                            <tr>
                                <th class="px-4 py-3">Type</th>
                                <th class="px-4 py-3">Asset</th>
                                <th class="px-4 py-3">Amount</th>
                                <th class="px-4 py-3">Description</th>
                                <th class="px-4 py-3">Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% transactions.forEach(tx=> { %>
                                <tr class="border-b border-gray-700">
                                    <td class="px-4 py-3 text-white">
                                        <%= tx.type %>
                                    </td>
                                    <td class="px-4 py-3 text-yellow-500 font-bold">
                                        <%= tx.asset_code %>
                                    </td>
                                    <td class="px-4 py-3 text-green-400 font-mono">
                                        <%= tx.amount %>
                                    </td>
                                    <td class="px-4 py-3">
                                        <%= tx.description %>
                                    </td>
                                    <td class="px-4 py-3">
                                        <%= new Date(tx.created_at).toLocaleDateString() %>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</body>

</html>