<!DOCTYPE html>
<html lang="en">
<head>
    <title>My Wallet</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 text-gray-100 min-h-screen p-8">
    <div class="max-w-4xl mx-auto">
        <div class="flex justify-between items-center mb-8">
            <h1 class="text-2xl font-bold text-green-400">Welcome, <%= user.username %></h1>
            <a href="/auth/logout" class="text-gray-400 hover:text-white">Logout</a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
            <% wallets.forEach(wallet => { %>
                <div class="bg-gray-800 p-6 rounded-lg border border-gray-700 relative overflow-hidden">
                    <h3 class="text-gray-400 text-sm uppercase tracking-wider"><%= wallet.asset_code %> BALANCE</h3>
                    <div class="flex items-baseline gap-2 mt-2">
                        <span class="text-4xl font-bold text-white"><%= wallet.balance %></span>
                    </div>
                </div>
            <% }) %>
        </div>

        <div class="bg-gray-800 p-6 rounded-lg mb-8">
            <h3 class="text-lg font-bold mb-4">Make a Purchase</h3>
            <form id="purchaseForm" class="flex gap-4">
                <select id="assetCode" class="bg-gray-700 text-white p-3 rounded border-none">
                    <% wallets.forEach(wallet => { %>
                        <option value="<%= wallet.asset_code %>"><%= wallet.asset_code %></option>
                    <% }) %>
                </select>

                <input type="number" id="amount" placeholder="Amount" class="flex-1 bg-gray-700 text-white p-3 rounded" required>
                <button type="submit" class="bg-red-500 hover:bg-red-600 text-white px-8 py-3 rounded font-bold">SPEND</button>
            </form>
            <p id="msg" class="mt-2 text-sm"></p>
        </div>

        <div class="bg-gray-800 rounded-lg overflow-hidden">
            <div class="p-4 bg-gray-700 font-bold">Recent Activity</div>
            <table class="w-full text-left">
                <tbody>
                    <% transactions.forEach(tx => { %>
                        <tr class="border-t border-gray-700">
                            <td class="p-4">
                                <span class="bg-gray-700 px-2 py-1 rounded text-xs font-bold mr-2">
                                    <%= tx.asset_code %>
                                </span>
                                <%= tx.type %>
                            </td>
                            <td class="p-4 text-<%= tx.amount < 0 ? 'red' : 'green' %>-400 font-mono">
                                <%= tx.amount %>
                            </td>
                            <td class="p-4 text-gray-500 text-sm">
                                <%= new Date(tx.created_at).toLocaleString() %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

    <script>
        document.getElementById('purchaseForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const amount = document.getElementById('amount').value;
            const assetCode = document.getElementById('assetCode').value;
            const msg = document.getElementById('msg');
            
            try {
                const res = await fetch('/api/transaction', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        type: 'PURCHASE',
                        amount: Number(amount),
                        assetCode: assetCode, 
                        idempotencyKey: crypto.randomUUID()
                    })
                });
                
                if (res.ok) {
                    window.location.reload(); 
                } else {
                    const data = await res.json();
                    msg.innerText = "Error: " + data.error;
                    msg.className = "mt-2 text-sm text-red-500";
                }
            } catch (err) {
                console.error(err);
            }
        });
    </script>
</body>
</html>